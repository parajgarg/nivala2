# Copy this file to .env and fill it in. Everything here is free to run.

PORT=3000
# First Manager PIN (used once, when the staff list is first created; change PINs later in the staff Team tab)
STAFF_PIN=1234
# Second PIN that unlocks the Accounts Directory (ledger, profit, CSV)
ACCOUNTS_PIN=2468

# ---- UPI (real NPCI deep link + QR; no gateway, no KYC) ----
# Any UPI ID you control. Customers' apps will pay this VPA directly.
MERCHANT_UPI_ID=mycollegeproject@okicici
MERCHANT_NAME=Nivala
# Minutes a checkout QR stays valid
PAYMENT_WINDOW_MIN=10
# true  -> a well-formed 12-digit UTR confirms the order immediately (fast demo, no real proof)
# false -> UTR puts the order in VERIFYING_PAYMENT; staff click "Approve UPI Payment" after checking their bank app
UTR_AUTO_CONFIRM=false

# ---- Demo / webhook ----
# true shows the "Simulate Instant UPI Webhook" button and accepts unsigned webhooks from the order owner or staff.
# Set false for a real deployment.
DEMO_MODE=true
# If set, /api/payments/upi-webhook also accepts calls signed with header
#   X-Nivala-Signature: hex(HMAC_SHA256(rawBody, WEBHOOK_SECRET))
WEBHOOK_SECRET=

# ---- Invoice header ----
RESTAURANT_NAME=Nivala
RESTAURANT_ADDRESS=12, Lake Road · Open 8 am – 11 pm
RESTAURANT_GSTIN=07AABCN1234D1Z5 (demo)
RESTAURANT_PHONE=+91 98765 43210

# ---- Email invoices (Gmail SMTP, free) ----
# 1. Turn on 2-Step Verification for the Gmail account.
# 2. Create an App Password: https://myaccount.google.com/apppasswords
# 3. Paste it below (spaces are fine). Leave both empty to save invoices to data/outbox/ instead.
SMTP_USER=
SMTP_PASS=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
MAIL_FROM_NAME=Nivala Billing

# ---- Auto-verify from bank SMS / UPI notifications (free) ----
# A forwarding app on the phone that receives payments POSTs each SMS to
#   http://<this-server>/api/payments/bank-alert?token=<BANK_ALERT_TOKEN>
# with JSON {"text": "<sms body>"} (or plain text). Credits that match an open order's exact amount confirm it.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(18).toString('base64url'))"
BANK_ALERT_TOKEN=
BANK_MATCH_WINDOW_MIN=90

# ---- Hosting (only needed when deployed) ----
# Public web address, used for the bank-alert link. On Render this is filled in automatically.
PUBLIC_URL=
# Where the database, uploads and invoice previews live. Empty = ./data
# On a Render persistent disk mounted at /var/data, set DATA_DIR=/var/data
DATA_DIR=
# Trust the host's proxy for real visitor IPs and HTTPS. Automatic on Render.
TRUST_PROXY=
